// ===== AGENDAR =====
        else if (opcao == 3) {

            // verifica login
            if (usuarioLogado == -1) {
                printf("\nFaca login primeiro (opcao 2)!\n");
            }
            // verifica limite
            else if (qtdAgendamentos >= 20) {
                printf("\nAgenda cheia!\n");
            }
            else {
                char novaData[11];
                char novaHora[6];
                int dia, mes, ano, h, min;

                printf("\n===== NOVO AGENDAMENTO =====\n");

                // entrada de dados
                printf("digite a data (dd/mm/aaaa):\n");
                scanf("%10s", novaData);

                printf("digite a hora (hh:mm):\n");
                scanf("%5s", novaHora);

                // valida data
                int dataValida = 0;
                if (strlen(novaData) == 10 &&
                    sscanf(novaData, "%d/%d/%d", &dia, &mes, &ano) == 3 &&
                    dia >= 1 && dia <= 31 &&
                    mes >= 1 && mes <= 12 &&
                    ano >= 2000) {
                    dataValida = 1;
                }

                // valida hora
                int horaValida = 0;
                if (strlen(novaHora) == 5 &&
                    sscanf(novaHora, "%d:%d", &h, &min) == 2 &&
                    h >= 0 && h <= 23 &&
                    min >= 0 && min <= 59) {
                    horaValida = 1;
                }

                // verifica horário ocupado
                int horarioOcupado = 0;
                for (int i = 0; i < qtdAgendamentos; i++) {
                    if (strcmp(novaData, data[i]) == 0 &&
                        strcmp(novaHora, hora[i]) == 0) {
                        horarioOcupado = 1;
                    }
                }

                if (dataValida == 0) {
                    printf("\nData invalida! Use o formato dd/mm/aaaa.\n");
                }
                else if (horaValida == 0) {
                    printf("\nHora invalida! Use o formato hh:mm.\n");
                }
                else if (horarioOcupado == 1) {
                    printf("\nJa existe um agendamento nesse horario!\n");
                }
                else {
                    // salvar agendamento
                    strcpy(data[qtdAgendamentos], novaData);
                    strcpy(hora[qtdAgendamentos], novaHora);

                    printf("digite a descricao (ex: consulta):\n");
                    scanf(" %49[^\n]", descricao[qtdAgendamentos]);

                    donoAgendamento[qtdAgendamentos] = usuarioLogado;

                    qtdAgendamentos++;

                    printf("\nAgendamento realizado com sucesso!\n");
                }
            }
        }


// ===== VER AGENDAMENTOS =====
        else if (opcao == 4) {

            // verifica login
            if (usuarioLogado == -1) {
                printf("\nFaca login primeiro (opcao 2)!\n");
            } else {
                printf("\n===== MEUS AGENDAMENTOS =====\n");

                int encontrou = 0;

                // listar agendamentos do usuário
                for (int i = 0; i < qtdAgendamentos; i++) {

                    if (donoAgendamento[i] == usuarioLogado) {
                        printf("[%d] %s as %s - %s\n", i + 1, data[i], hora[i], descricao[i]);
                        encontrou = 1;
                    }
                }

                // nenhum encontrado
                if (encontrou == 0) {
                    printf("Voce nao tem agendamentos.\n");
                }
            }
        }


// ===== CANCELAR AGENDAMENTO =====
        else if (opcao == 5) {

            // verifica login
            if (usuarioLogado == -1) {
                printf("\nFaca login primeiro (opcao 2)!\n");
            } else {
                int numero;

                // listar agendamentos do usuário
                printf("\n===== CANCELAR AGENDAMENTO =====\n");
                for (int i = 0; i < qtdAgendamentos; i++) {
                    if (donoAgendamento[i] == usuarioLogado) {
                        printf("[%d] %s as %s - %s\n", i + 1, data[i], hora[i], descricao[i]);
                    }
                }

                printf("digite o numero do agendamento (0 para voltar):\n");
                scanf("%d", &numero);

                if (numero != 0) {
                    int posicao = numero - 1;

                    // verifica se o número existe e é do usuário
                    if (posicao < 0 || posicao >= qtdAgendamentos ||
                        donoAgendamento[posicao] != usuarioLogado) {
                        printf("\nNumero invalido!\n");
                    } else {
                        // remover agendamento (puxa os próximos uma posição para trás)
                        for (int j = posicao; j < qtdAgendamentos - 1; j++) {
                            strcpy(data[j], data[j + 1]);
                            strcpy(hora[j], hora[j + 1]);
                            strcpy(descricao[j], descricao[j + 1]);
                            donoAgendamento[j] = donoAgendamento[j + 1];
                        }

                        qtdAgendamentos--;

                        printf("\nAgendamento cancelado!\n");
                    }
                }
            }
        }


// ===== SAIR (trocar o "else if (opcao == 3)" antigo por este) =====
        else if (opcao == 6) {
