    char data[20][11];
    char hora[20][6];
    char descricao[20][50];
    int donoAgendamento[20];
    int qtdAgendamentos = 0;
    int usuarioLogado = -1;


// ===== LOGIN (colocar depois de loginValido = 1;) =====
                    usuarioLogado = i;


